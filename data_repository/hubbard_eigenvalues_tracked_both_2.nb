   3.995353727257449*^9, 3.995353727634899*^9}, 3.995353828089808*^9, {
   3.995354063469314*^9, 3.995354065228297*^9}, {3.9962063599873466`*^9, 
   3.996206376767703*^9}},
 CellLabel->
  "In[681]:=",ExpressionUUID->"b0361ce6-fe8f-4d24-9d64-33d426d29b2f"],


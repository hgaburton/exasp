   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[CapitalEpsilon]", "1"], ",", 
     SubscriptBox["\[CapitalEpsilon]", "2"], ",", 
     SubscriptBox["\[CapitalEpsilon]", "sink"]}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"U", "-", 
         SqrtBox[
          RowBox[{
           RowBox[{"16", " ", 
            SuperscriptBox["t", "2"]}], "+", 
           SuperscriptBox["U", "2"]}]]}], ")"}]}], ",", "U", ",", 
      FractionBox["U", "2"]}], "}"}], "/.", 

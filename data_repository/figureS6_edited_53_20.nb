Cell[CellGroupData[{

Cell["Function to read noiseless or simulated data from file", "Subsection",
 CellChangeTimes->{{3.964082970872484*^9, 
  3.964082977724742*^9}},ExpressionUUID->"3350f798-bb0a-489e-a944-\
ab65be3f3462"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DtSuffix", "[", "dt_", "]"}], ":=", 
   RowBox[{"StringPadLeft", "[", 
    RowBox[{
     RowBox[{"ToString", "[", 
      RowBox[{"Round", "[", 
       RowBox[{"10", "*", "dt"}], "]"}], "]"}], ",", "2", ",", "\"\<0\>\""}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NoiselessData", "[", 
    RowBox[{"T_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"\"\<statevector_53_20/dt_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\</statevector_\>\"", "<>", 
       RowBox[{"ToString", "[", "T", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\<.txt\>\""}], 
      ",", "\"\<Table\>\""}], "]"}], "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"2", ";;"}], ",", "All"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SimulatedData", "[", 
    RowBox[{"T_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"\"\<simulated_53_20/dt_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\</simulated_\>\"", "<>", 
       RowBox[{"ToString", "[", "T", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\<.txt\>\""}], 
      ",", "\"\<Table\>\""}], "]"}], "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"2", ";;"}], ",", "All"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HardwareData", "[", 
    RowBox[{"T_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"\"\<hardware_53_20/dt_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\</hardware_\>\"", "<>", 
       RowBox[{"ToString", "[", "T", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"DtSuffix", "[", "dt", "]"}], "<>", "\"\<.txt\>\""}], 
      ",", "\"\<Table\>\""}], "]"}], "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"2", ";;"}], ",", "All"}], "\[RightDoubleBracket]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.964081200771299*^9, 3.964081222117591*^9}, {
   3.9640812545476227`*^9, 3.964081284698511*^9}, {3.9640813301909733`*^9, 
